# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: register slash commands to a single guild during development (instant), omit for global
DISCORD_DEV_GUILD_ID=

# ---- Database ----
DATABASE_URL=postgresql://rize:rize@localhost:5432/rize

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Solana ----
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Helius webhook auth header value (Helius -> Rize API)
HELIUS_WEBHOOK_SECRET=
# Rize's own fee wallet (receives platform fee via Solana Pay split)
RIZE_FEE_WALLET=
# Fee in basis points (150 = 1.5%)
RIZE_FEE_BPS=150

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ---- API / Web ----
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Random 32+ char string for signing dashboard sessions
SESSION_SECRET=
